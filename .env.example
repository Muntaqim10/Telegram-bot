REDIS_URL="redis://localhost:6379/0"
TRADIER_ACCESS_TOKEN="your_tradier_token_here"
FINNHUB_TOKEN="your_finnhub_token_here"
TIINGO_TOKEN="your_tiingo_token_here"
GROQ_API_KEY="your_groq_api_key_here"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Minimum seconds before the ORB strategy will re-evaluate the same 
# ticker for a new signal after one has already fired (default: 900 = 15 min)
ORB_COOLDOWN_SECONDS="900"

# Minimum seconds before the alert gateway will re-send a Telegram 
# alert for the same ticker+direction combo, even if the strategy 
# re-triggers sooner (default: 3600 = 1 hour)
ALERT_DEDUP_SECONDS="3600"
